# Local Decider accepts this literal placeholder; this is not a cloud API key.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=local-placeholder
TYPESAFE_BASE_URL=http://127.0.0.1:8000
JEV_MODEL=decider-2b
JEV_ROUTING=on
JEV_MIN_CONFIDENCE=0.80
JEV_TIMEOUT_MS=2000
JEV_MAX_STATE_CHARS=6000
JEV_MAX_MESSAGE_CHARS=1500
JEV_DIRECT_CALLS=false
JEV_ON_NONE=passthrough
UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex
